# Network / server
PORT=3000
JWT_SECRET=change-me-local
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# Active provider credentials
OPENAI_API_KEY=
ALICE_API_KEY=
ALICE_API_URL=https://api.openai.com/v1/chat/completions
LLM_TIMEOUT_MS=120000

# Recommended tiers (for manual selection policy)
# Strong profile: use for final legal pass
LLM_STRONG_PROVIDER=openai
LLM_STRONG_MODEL=gpt-6.1-sol

# Budget profile: use for first-pass screening
LLM_BUDGET_PROVIDER=openai
LLM_BUDGET_MODEL=gpt-6-luna

# Optional default that UI can use in next iterations
# (currently app reads llmProvider/llmModel from settings page)
LLM_DEFAULT_TIER=budget
